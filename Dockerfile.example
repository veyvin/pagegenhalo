# 如果需要使用 lxml，可以使用这个 Dockerfile
# 在 Dockerfile 中安装系统依赖

FROM python:3.11-slim

# 安装 lxml 所需的系统依赖
RUN apt-get update && apt-get install -y \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY . .

# 暴露端口
EXPOSE 5555

# 运行应用
CMD ["python", "app.py"]

